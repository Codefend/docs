{
  "name": "codefend-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "spell:check": "cspell \"{src/**/*.md,.vitepress/**/*.{ts,mts,vue},scripts/**/*.mjs,README.md}\" --no-progress --show-suggestions",
    "examples:check": "node scripts/check-examples.mjs && node scripts/check-language-examples.mjs",
    "examples:update": "node scripts/update-example-output.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "check": "npm run spell:check && npm run examples:check && npm run docs:build && npm run docs:check"
  },
  "overrides": {
    "vitepress": {
      "vite": "^6.4.6"
    }
  },
  "devDependencies": {
    "codefend": "^3.3.0",
    "cspell": "^10.5.2",
    "vitepress": "^1.6.4",
    "vue": "^3.5.46"
  },
  "author": "Mounzer Adas",
  "license": "MIT"
}
